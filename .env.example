# Optional. Point this at a form backend (Formspree, Basin, Web3Forms, …) and
# the contact form POSTs JSON to it. Leave it unset and the form falls back to
# opening the visitor's email client with the message pre-filled.
#
#   1. Create a form at https://formspree.io
#   2. Copy its endpoint below
#   3. Rename this file to .env and restart `npm run dev`
VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
